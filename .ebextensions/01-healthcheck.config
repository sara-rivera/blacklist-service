option_settings:
  # Health check del Load Balancer apuntando a /ping
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /ping
    HealthCheckInterval: 15
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    MatcherHTTPCode: 200
  # Reportes de salud mejorados (Enhanced health)
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
  # Auto Scaling: mínimo 3, máximo 6 instancias
  aws:autoscaling:asg:
    MinSize: 3
    MaxSize: 6
