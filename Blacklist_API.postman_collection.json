{
  "info": {
    "name": "Blacklist API",
    "description": "API REST del microservicio de lista negra global de emails.\n\nDesplegado en AWS Elastic Beanstalk con PostgreSQL en Amazon RDS.\n\n**Autorización:** Bearer Token en el encabezado `Authorization` para todas las rutas de `/blacklists`.\n\n**Variables del environment:** `base_url` (URL del ambiente) y `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"test_email\")) {",
          " pm.collectionVariables.set(\"test_email\", `test_${Date.now()}@ejemplo.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/ping",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ping"
          ]
        },
        "description": "Health check del servicio. Lo usa el Application Load Balancer de Elastic Beanstalk para determinar si una instancia está sana. Devuelve la versión desplegada. No requiere autorización.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Ejemplo 200",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ping",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ping"
              ]
            },
            "description": "Endpoint usado por el health check de Beanstalk. Devuelve la versión desplegada.",
            "auth": {
              "type": "noauth"
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"ok\",\n  \"version\": \"1.0\"\n}"
        }
      ]
    },
    {
      "name": "Agregar email a lista negra",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists"
          ]
        },
        "description": "Agrega un email a la lista negra global.\n\n**Body (JSON)**\n- `email` (String, obligatorio): email del cliente.\n- `app_uuid` (String, obligatorio): UUID de la aplicación cliente.\n- `blocked_reason` (String, opcional): motivo, máximo 255 caracteres.\n\nEl servicio registra la IP de origen y la fecha/hora de la solicitud.\n\n**Respuesta:** 201 con mensaje de confirmación y el registro creado.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"blocked_reason\": \"Solicitud del cliente\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Mensaje de confirmación\", () => pm.expect(pm.response.json().msg).to.include(\"agregado\"));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Ejemplo 201",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blacklists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blacklists"
              ]
            },
            "description": "Agrega un email a la lista negra global. Body: email (obligatorio), app_uuid (UUID obligatorio), blocked_reason (opcional, máx. 255). Guarda internamente IP y fecha/hora.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"blocked_reason\": \"Solicitud del cliente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"msg\": \"El email cliente@ejemplo.com fue agregado a la lista negra global\",\n  \"data\": {\n    \"id\": 1,\n    \"email\": \"cliente@ejemplo.com\",\n    \"app_uuid\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"blocked_reason\": \"Solicitud del cliente\",\n    \"ip_address\": \"181.50.10.20\",\n    \"created_at\": \"2026-10-18T15:26:26\"\n  }\n}"
        }
      ]
    },
